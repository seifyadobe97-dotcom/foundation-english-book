{
  "id": "present-simple",
  "code": "ASGQPRSIM",
  "title": "Present Simple",
  "titleAr": "المضارع البسيط",
  "subtitle": "افهم القاعدة… وطبّق عليها خطوة بخطوة",
  "requiredPassRate": 0.6,
  "sections": [
    {
      "id": "uses",
      "tag": "01 · افهم الفكرة",
      "title": "بنستخدمه إمتى؟",
      "short": "العادات والحقائق والأشياء المتكررة",
      "subtitle": "مش لازم الحدث يكون بيحصل دلوقتي",
      "duration": "4 دقائق",
      "description": "بنستخدم المضارع البسيط لما نتكلم عن **عادة بتتكرر** أو **حقيقة معروفة** أو **حالة مستقرة**. ركّز على المعنى قبل أي كلمة دالة.",
      "rule": [
        "فاعل",
        "+",
        "فعل مصدر (مع s للمفرد)",
        "+",
        "تكملة الجملة"
      ],
      "tiles": [
        {
          "icon": "repeat",
          "label": "عادة",
          "text": "I study every day."
        },
        {
          "icon": "sun",
          "label": "حقيقة",
          "text": "The sun rises in the east."
        }
      ],
      "gold": {
        "title": "القاعدة الذهبية ١",
        "body": "كلمات زي <bdi>usually</bdi> و<bdi>every day</bdi> بتوجهك للمضارع البسيط، لكن اختار الفعل حسب **الفاعل والمعنى**؛ مش الكلمة وحدها."
      },
      "examples": [
        {
          "en": "I usually study in the evening.",
          "ar": "أنا عادةً بذاكر بالليل."
        },
        {
          "en": "She likes English.",
          "ar": "هي بتحب الإنجليزي."
        }
      ],
      "mistake": {
        "wrong": "I am study every day.",
        "right": "I study every day.",
        "why": "العادات اليومية بنعبّر عنها بالمضارع البسيط."
      },
      "titleAr": "بنستخدمه إمتى؟",
      "questionIds": [
        "ASGQPRSIM-AGG-01",
        "ASGQPRSIM-AGG-04",
        "ASGQPRSIM-AGG-09"
      ]
    },
    {
      "id": "affirmative",
      "tag": "02 · كوّن الجملة",
      "title": "الإثبات مع الفاعل",
      "short": "الفعل في المصدر أو مع إضافة s",
      "subtitle": "بص على الفاعل قبل ما تختار",
      "duration": "5 دقائق",
      "description": "مع <bdi>I / we / you / they</bdi> أو الفاعل الجمع بنستخدم الفعل في **المصدر من غير to**. مع <bdi>he / she / it</bdi> أو الاسم المفرد بنضيف للفعل غالبًا <bdi>s</bdi>.",
      "rule": [
        "فاعل (I / we / you / they / اسم جمع)",
        "+",
        "فعل مصدر"
      ],
      "alternativeRule": [
        "فاعل (he / she / it / اسم مفرد)",
        "+",
        "فعل + s"
      ],
      "tiles": [
        {
          "icon": "users",
          "label": "جمع",
          "text": "They play football."
        },
        {
          "icon": "user",
          "label": "مفرد",
          "text": "He plays football."
        }
      ],
      "gold": {
        "title": "القاعدة الذهبية ٢",
        "body": "حدد **الفاعل الحقيقي**. لا تتأثر باسم قريب من الفراغ؛ الفعل لازم يطابق الفاعل نفسه."
      },
      "examples": [
        {
          "en": "We go to school by bus.",
          "ar": "إحنا بنروح المدرسة بالأتوبيس."
        },
        {
          "en": "She reads every day.",
          "ar": "هي بتقرأ كل يوم."
        }
      ],
      "mistake": {
        "wrong": "They goes to school.",
        "right": "They go to school.",
        "why": "مع They بنستخدم الفعل من غير s."
      },
      "titleAr": "الإثبات مع الفاعل",
      "questionIds": [
        "ASGQPRSIM-AGG-02",
        "ASGQPRSIM-BOOK-01",
        "ASGQPRSIM-BOOK-09"
      ]
    },
    {
      "id": "spelling",
      "tag": "03 · ركز في الإضافات",
      "title": "إضافات s / es / ies",
      "short": "المفرد الغائب وقواعد الكتابة",
      "subtitle": "تغيير صغير في الفعل يفرق في الإجابة",
      "duration": "5 دقائق",
      "description": "مع المفرد الغائب بنضيف <bdi>s</bdi> لمعظم الأفعال. نستخدم <bdi>es</bdi> مع أفعال زي <bdi>watch → watches</bdi> و<bdi>go → goes</bdi>. لو الفعل بينتهي بحرف ساكن ثم <bdi>y</bdi>، بنحوّلها إلى <bdi>ies</bdi>.",
      "rule": [
        "فاعل (he / she / it / اسم مفرد)",
        "+",
        "فعل + s / es / ies"
      ],
      "tiles": [
        {
          "icon": "check",
          "label": "+ s",
          "text": "read → reads"
        },
        {
          "icon": "check",
          "label": "+ es",
          "text": "watch → watches"
        },
        {
          "icon": "check",
          "label": "y → ies",
          "text": "study → studies"
        }
      ],
      "gold": {
        "title": "القاعدة الذهبية ٣",
        "body": "بعد <bdi>does</bdi> أو <bdi>doesn’t</bdi> الفعل يرجع **للمصدر** حتى لو الفاعل مفرد: <bdi>Does he study?</bdi>"
      },
      "examples": [
        {
          "en": "She goes to school every day.",
          "ar": "هي بتروح المدرسة كل يوم."
        },
        {
          "en": "He studies English.",
          "ar": "هو بيدرس إنجليزي."
        }
      ],
      "mistake": {
        "wrong": "He studys English.",
        "right": "He studies English.",
        "why": "study: قبل y حرف ساكن؛ نحذف y ونضيف ies. لكن play تصبح plays."
      },
      "titleAr": "إضافات s / es / ies",
      "questionIds": [
        "ASGQPRSIM-AGG-10",
        "ASGQPRSIM-BOOK-02",
        "ASGQPRSIM-BOOK-03",
        "ASGQPRSIM-BOOK-10"
      ]
