    {
      "id": "negative",
      "tag": "04 · انفي صح",
      "title": "النفي بـ don’t وdoesn’t",
      "short": "بعد أداة النفي الفعل يرجع للمصدر",
      "subtitle": "الجزء ده أساسي ومتكرر في الأسئلة",
      "duration": "4 دقائق",
      "description": "مع <bdi>I / we / you / they</bdi> بنستخدم <bdi>don’t</bdi>، ومع <bdi>he / she / it</bdi> بنستخدم <bdi>doesn’t</bdi>. في الحالتين الفعل اللي بعدهم **مصدر بدون أي إضافة**.",
      "rule": [
        "فاعل",
        "+",
        "don’t / doesn’t",
        "+",
        "فعل مصدر"
      ],
      "tiles": [
        {
          "icon": "users",
          "label": "جمع أو I",
          "text": "They don’t work."
        },
        {
          "icon": "user",
          "label": "مفرد",
          "text": "He doesn’t work."
        }
      ],
      "gold": {
        "title": "القاعدة الذهبية ٤",
        "body": "وجود <bdi>doesn’t</bdi> معناه إن **s راحت لأداة النفي**. فبنقول <bdi>doesn’t drink</bdi> مش <bdi>doesn’t drinks</bdi>."
      },
      "examples": [
        {
          "en": "He does not drink coffee.",
          "ar": "هو مش بيشرب قهوة."
        },
        {
          "en": "My father doesn’t work on Sundays.",
          "ar": "والدي مش بيشتغل يوم الأحد."
        }
      ],
      "mistake": {
        "wrong": "She doesn’t plays.",
        "right": "She doesn’t play.",
        "why": "بعد doesn’t الفعل مصدر. أما be فبننفيها مباشرة: She isn’t ready."
      },
      "titleAr": "النفي بـ don’t وdoesn’t",
      "questionIds": [
        "ASGQPRSIM-BOOK-04",
        "ASGQPRSIM-BOOK-05"
      ]
    },
    {
      "id": "questions",
      "tag": "05 · اسأل بشكل صحيح",
      "title": "السؤال بـ Do وDoes",
      "short": "نعم/لا والسؤال بأداة استفهام",
      "subtitle": "قدّم أداة السؤال وخلي الفعل مصدر",
      "duration": "5 دقائق",
      "description": "سؤال نعم أو لا بيبدأ بـ<bdi>Do</bdi> مع الجمع و<bdi>Does</bdi> مع المفرد الغائب. ولو عايز تسأل عن معلومة، حط أداة السؤال مثل <bdi>Where</bdi> قبل <bdi>do/does</bdi>. بعد الفاعل الفعل مصدر.",
      "rule": [
        "Do / Does",
        "+",
