      "tiles": [
        {
          "icon": "user",
          "label": "مع المفرد",
          "text": "Does he play?"
        },
        {
          "icon": "users",
          "label": "مع الجمع",
          "text": "Do they play?"
        }
      ],
      "gold": {
        "title": "القاعدة الذهبية ٥",
        "body": "لو <bdi>Who</bdi> هي **الفاعل نفسه** بنقول <bdi>Who knows?</bdi> ومش لازم نحط <bdi>does</bdi>؛ فرّق بين السؤال عن الفاعل والسؤال عن باقي الجملة."
      },
      "examples": [
        {
          "en": "Does your brother play football?",
          "ar": "هل أخوك بيلعب كورة؟"
